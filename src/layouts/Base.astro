---
import '../styles/global.css';
import { t, locales, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const ui = t(lang);
const other = locales.find((l) => l !== lang)!;
const path = Astro.url.pathname;
const otherPath = path.replace(`/${lang}/`, `/${other}/`);
const onHome = /^\/(en|es)\/?$/.test(path);
const anchor = (id: string) => (onHome ? `#${id}` : `/${lang}/#${id}`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? ui.siteTitle}</title>
    <meta name="description" content={description ?? ui.siteDescription} />
    <link rel="alternate" hreflang="en" href={path.replace(`/${lang}/`, '/en/')} />
    <link rel="alternate" hreflang="es" href={path.replace(`/${lang}/`, '/es/')} />
    <script is:inline>
      try {
        var th = localStorage.getItem('theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={`/${lang}/`} aria-label="Juan Suárez">
          <span class="mark" aria-hidden="true">JS</span>
          <span class="brand-name">Juan Suárez</span>
        </a>
        <nav aria-label="Main" class="nav">
          <ul>
            <li><a href={anchor('method')}>{ui.nav.method}</a></li>
            <li><a href={anchor('templates')}>{ui.nav.templates}</a></li>
            <li><a href={anchor('work')}>{ui.nav.work}</a></li>
            <li><a href={anchor('journey')}>{ui.nav.journey}</a></li>
            <li><a href={`/${lang}/cv/`} aria-current={path.startsWith(`/${lang}/cv`) ? 'page' : undefined}>{ui.nav.cv}</a></li>
            <li><a href={anchor('contact')}>{ui.nav.contact}</a></li>
          </ul>
        </nav>
        <div class="controls">
          <a class="icon-btn" href={otherPath} hreflang={other} lang={other} aria-label={`${ui.lang.label}: ${other.toUpperCase()}`} title={other === 'es' ? 'Español' : 'English'}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.4 5.8 12 3Z"/></svg>
            <span class="icon-code">{other.toUpperCase()}</span>
          </a>
          <button type="button" class="icon-btn" id="theme-toggle" data-labels={JSON.stringify(ui.theme)} data-prefix={ui.theme.label} aria-label={ui.theme.label}>
            <svg class="i-system" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
            <svg class="i-light" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="i-dark" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">© 2026 {ui.footer}</div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var labels = JSON.parse(btn.dataset.labels);
        var order = ['system', 'light', 'dark'];
        var cur = 'system';
        try {
          var s = localStorage.getItem('theme');
          if (s === 'light' || s === 'dark') cur = s;
        } catch (e) {}
        function apply(v) {
          var root = document.documentElement;
          if (v === 'system') delete root.dataset.theme;
          else root.dataset.theme = v;
          btn.dataset.mode = v;
          btn.setAttribute('aria-label', btn.dataset.prefix + ': ' + labels[v]);
          btn.title = btn.dataset.prefix + ': ' + labels[v];
          try {
            if (v === 'system') localStorage.removeItem('theme');
            else localStorage.setItem('theme', v);
          } catch (e) {}
        }
        apply(cur);
        btn.addEventListener('click', function () {
          cur = order[(order.indexOf(cur) + 1) % order.length];
          apply(cur);
        });

        var links = document.querySelectorAll('.nav a[href^="#"]');
        if (links.length && 'IntersectionObserver' in window) {
          var map = {};
          links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                links.forEach(function (a) { a.removeAttribute('aria-current'); });
                var a = map[en.target.id];
                if (a) a.setAttribute('aria-current', 'true');
              }
            });
          }, { rootMargin: '-35% 0px -60% 0px' });
          Object.keys(map).forEach(function (id) {
            var el = document.getElementById(id);
            if (el) io.observe(el);
          });
        }
      })();
    </script>
  </body>
</html>
