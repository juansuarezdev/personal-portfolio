---
import { url } from '../i18n/url';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Juan Suárez</title>
    <meta http-equiv="refresh" content={`0; url=${url("/en/")}`} />
    <link rel="canonical" href={url("/en/")} />
    <script is:inline define:vars={{ EN: url("/en/"), ES: url("/es/") }}>
      var l = (navigator.language || 'en').toLowerCase();
      location.replace(l.indexOf('es') === 0 ? ES : EN);
    </script>
  </head>
  <body>
    <p><a href={url("/en/")}>English</a> · <a href={url("/es/")}>Español</a></p>
  </body>
</html>
