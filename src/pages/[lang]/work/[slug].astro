---
import Base from '../../../layouts/Base.astro';
import { t, locales, type Lang } from '../../../i18n/ui';
import { url } from '../../../i18n/url';
import { allWork, hasPage } from '../../../data/work';
import WorkDetail from '../../../components/WorkDetail.astro';

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    allWork.filter(hasPage).map((w) => ({ params: { lang, slug: w.slug }, props: { w } })),
  );
}
const lang = Astro.params.lang as Lang;
const { w } = Astro.props;
const ui = t(lang);
---

<Base lang={lang} title={`${w.title[lang]} — Juan Suárez`} description={w.summary[lang]}>
  <div class="wrap case">
    <p><a href={url(`/${lang}/#work`)}>← {ui.work.back}</a></p>
    <header class="case-head">
      <div class="case-meta">
        <span class="a-chip">{ui.work.status[w.status]}</span>
      </div>
      <h1>{w.title[lang]}</h1>
      <p class="lede">{w.summary[lang]}</p>
      <p class="case-stack"><span class="label">{ui.work.stack}</span> {w.stack.join(' · ')}</p>
    </header>

    <WorkDetail w={w} lang={lang} page={true} />
  </div>
</Base>

<style is:global>
  .case { padding-top: 32px; padding-bottom: 64px; }
  .case-head { padding: 24px 0 8px; }
  .case-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .case h1 { font-size: clamp(1.75rem, 1rem + 3vw, 3rem); letter-spacing: -0.03em; max-width: 22ch; }
  .case-stack { font-family: var(--mono); font-size: 0.8125rem; color: var(--muted); }
  .case-stack .label { margin-right: 8px; }
  .case-body { display: grid; gap: 0; margin-top: 16px; }
  .case-sec { padding: 24px 0; border-top: 1px solid var(--line); }
  .case-sec h2 { font-size: 1.375rem; }
  .case-demo { padding: 32px 0 8px; border-top: 1px solid var(--line); }
  .case-demo h2 { margin-bottom: 16px; }
  .case-links { margin-top: 24px; }
  .a-chip { font-family: var(--mono); font-size: 0.75rem; padding: 2px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }
  .a-chip.a-wip { color: var(--wip); border-color: var(--wip); }
</style>
