---
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import { t, locales, type Lang } from '../../i18n/ui';
import { summary } from '../../data/cv';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const ui = t(lang);
---

<Base lang={lang} title={`Juan Suárez - ${ui.cv.title}`} description={summary[lang]}>
  <div class="wrap cv-wrap">
    <div class="cv-actions">
      <a class="a-btn" href={`/${lang}/`}>← {ui.cv.back}</a>
      <button type="button" class="a-btn cv-print" id="cv-print">{ui.cv.savePdf}</button>
    </div>
    <CvDocument lang={lang} />
  </div>

  <script is:inline>
    document.getElementById('cv-print').addEventListener('click', function () { window.print(); });
  </script>
</Base>
