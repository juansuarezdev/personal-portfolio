---
import Base from '../../layouts/Base.astro';
import { t, locales, type Lang } from '../../i18n/ui';
import { url, BASE } from '../../i18n/url';
import { work, moreWork, hasPage } from '../../data/work';
import { career } from '../../data/career';
import { templates as allTemplates } from '../../data/templates';
import WorkDetail from '../../components/WorkDetail.astro';
import CvDocument from '../../components/CvDocument.astro';
import { role } from '../../data/cv';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const ui = t(lang);
const steps = ui.method.steps;
const templates = allTemplates[lang];
const gridItems: { type: 'card' | 'drawer'; w: (typeof work)[number]; i: number }[] = [];
{
  let group: { w: (typeof work)[number]; i: number }[] = [];
  const flush = () => {
    group.forEach((g) => gridItems.push({ type: 'card', ...g }));
    group.filter((g) => hasPage(g.w)).forEach((g) => gridItems.push({ type: 'drawer', ...g }));
    group = [];
  };
  work.forEach((w, i) => {
    if (w.featured) {
      flush();
      gridItems.push({ type: 'card', w, i });
      if (hasPage(w)) gridItems.push({ type: 'drawer', w, i });
    } else group.push({ w, i });
  });
  flush();
}
const bars = [[92, 64], [78, 52], [86, 40], [70, 58], [90, 46], [66, 72], [82, 50], [74, 60]];
const parseLine = (l: string) => {
  const mark = l.match(/^(✓|✗)\s+(.*)$/);
  if (mark) return { kind: mark[1] === '✓' ? 'ok' : 'bad', key: mark[1], text: mark[2] };
  const id = l.match(/^(R\d+|\d+\.|[AB]\.)\s+(.*)$/);
  if (id) return { kind: 'id', key: id[1].replace(/\.$/, ''), text: id[2] };
  const lab = l.match(/^([^:.]{3,18}):\s+(.*)$/);
  if (lab) return { kind: 'label', key: lab[1], text: lab[2] };
  return { kind: 'plain', key: '', text: l };
};
// Paths are drawn from destination to origin: the dash spacing contracts toward the path start,
// so the dashes appear to travel from the origin city to the destination.
const arcsD = ['M380 70 Q235 10 90 170', 'M640 100 Q510 40 380 70', 'M910 170 Q775 20 640 100'];
const arcsM = ['M296 160 C 296 90, 200 74, 64 74', 'M64 272 C 64 214, 296 224, 296 160', 'M296 382 C 296 332, 64 340, 64 272'];
const mobilePos = [{ x: 64, y: 74, side: 'a' }, { x: 296, y: 160, side: 'l' }, { x: 64, y: 272, side: 'r' }, { x: 296, y: 382, side: 'l' }];
const stops = [
  { x: 90, y: 170, code: 'LPA', when: '2021 – 2023' },
  { x: 380, y: 70, code: 'MUC', when: lang === 'es' ? 'jul – sep 2023' : 'Jul – Sep 2023' },
  { x: 640, y: 100, code: 'BER', when: lang === 'es' ? 'mar – jun 2024' : 'Mar – Jun 2024' },
  { x: 910, y: 170, code: 'LPA', when: lang === 'es' ? 'oct 2024 →' : 'Oct 2024 →' },
];
---

<Base lang={lang} >
  <div class="a-hero">
    <div class="wrap">
      <p class="a-kicker">Juan Suárez · Full-stack</p>
      <h1 class="a-title">{ui.title}</h1>
      <p class="a-sub">{ui.subtitle}</p>

      <noscript><style>.a-arc { animation: none !important; stroke-dasharray: 0.02 0.03 !important; }</style></noscript>
      <figure class="a-map">
        <svg class="a-map-d" viewBox="0 0 1000 230" role="img" aria-label="Las Palmas, Munich, Berlin, Las Palmas">
          {arcsD.map((d, i) => <path class={`a-arc a-d${i + 1}`} pathLength="1" d={d} />)}
          {stops.map((s) => (
            <g>
              <circle class="a-st" cx={s.x} cy={s.y} r="9" />
              <circle class="a-st-in" cx={s.x} cy={s.y} r="3.5" />
              <text class="a-code" x={s.x} y={s.y + 34} text-anchor="middle">{s.code}</text>
              <text class="a-when2" x={s.x} y={s.y + 52} text-anchor="middle">{s.when}</text>
            </g>
          ))}
        </svg>
        <svg class="a-map-m" viewBox="0 0 360 430" role="img" aria-label="Las Palmas, Munich, Berlin, Las Palmas">
          {arcsM.map((d, i) => <path class={`a-arc a-d${i + 1}`} pathLength="1" d={d} />)}
          {stops.map((st, i) => {
            const q = mobilePos[i];
            const above = q.side === 'a';
            const dx = above ? -11 : q.side === 'r' ? 24 : -24;
            const anchor = q.side === 'l' ? 'end' : 'start';
            const dy = above ? -42 : -2;
            return (
              <g>
                <circle class="a-st" cx={q.x} cy={q.y} r="11" />
                <circle class="a-st-in" cx={q.x} cy={q.y} r="4.5" />
                <text class="a-code a-code-m" x={q.x + dx} y={q.y + dy} text-anchor={anchor}>{st.code}</text>
                <text class="a-when2 a-when-m" x={q.x + dx} y={q.y + dy + 20} text-anchor={anchor}>{st.when}</text>
              </g>
            );
          })}
        </svg>
      </figure>
    </div>
  </div>

  <div class="wrap">
    <section id="method" aria-labelledby="h-method">
      <p class="a-eyebrow">01</p>
      <h2 id="h-method">{ui.method.heading}</h2>
      <div class="a-pipe" id="a-pipe" role="group" aria-label={ui.method.heading}>
        <span class="a-packet" aria-hidden="true"></span>
        <span class="a-packet" aria-hidden="true"></span>
        <span class="a-packet" aria-hidden="true"></span>
        {steps.map((s, i) => (
          <button type="button" class="a-node" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="a-dot" aria-hidden="true"></span>
            <span class="a-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="a-name">{s.name}</span>
            <span class="a-ntext">{s.text}</span>
          </button>
        ))}
      </div>
      <p class="a-detail" id="a-detail" aria-live="polite" data-steps={JSON.stringify(steps.map((s) => s.text))}>
        {steps[0].text}
      </p>
    </section>

    <section id="templates" aria-labelledby="h-templates">
      <p class="a-eyebrow">02</p>
      <h2 id="h-templates">{ui.templates.heading}</h2>
      <p class="lede">{ui.templates.intro}</p>
      <div class="a-doc" id="a-doc">
        <div class="a-tabs" role="tablist" aria-label={ui.templates.heading}>
          {templates.map((tp, i) => (
            <button type="button" role="tab" class="a-tab" id={`tab-${tp.key}`} aria-controls={`panel-${tp.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-key={tp.key}>{tp.tab}</button>
          ))}
        </div>
        {templates.map((tp, i) => (
          <div class="t-panel" role="tabpanel" id={`panel-${tp.key}`} aria-labelledby={`tab-${tp.key}`} data-key={tp.key} data-count={tp.sections.length} hidden={i !== 0}>
            <div class="t-grid">
              <div class="t-paper">
                <div class="t-paper-head">
                  <strong>{tp.title}</strong>
                  <span>{tp.meta}</span>
                </div>
                {tp.sections.map((sec, n) => (
                  <button type="button" class="t-block" data-n={n} aria-label={`${n + 1}. ${sec.h}`} aria-current={n === 0 ? 'true' : 'false'}>
                    <span class="t-bn">{String(n + 1).padStart(2, '0')}</span>
                    <span class="t-bh">{sec.h}</span>
                    <span class="t-bars" aria-hidden="true">
                      <i style={`width:${bars[n % bars.length][0]}%`}></i>
                      <i style={`width:${bars[n % bars.length][1]}%`}></i>
                    </span>
                  </button>
                ))}
              </div>
              <div class="t-inspector" aria-live="polite">
                {tp.sections.map((sec, n) => (
                  <article class="t-ins" data-n={n} hidden={n !== 0}>
                    <p class="t-step">{String(n + 1).padStart(2, '0')} {ui.templates.of} {String(tp.sections.length).padStart(2, '0')}</p>
                    <h4>{sec.h}</h4>
                    <p class="t-tag">{ui.templates.hintTag}</p>
                    <p class="t-hint">{sec.hint}</p>
                    <p class="t-tag">{ui.templates.exampleTag}</p>
                    <ul class="t-example">
                      {sec.example.map((l) => {
                        const x = parseLine(l);
                        return (
                          <li class={`t-ex t-${x.kind}`}>
                            {x.key && <span class="t-key">{x.key}</span>}
                            <span>{x.text}</span>
                          </li>
                        );
                      })}
                    </ul>
                    <p class="t-why"><span>{ui.templates.whyTag}</span>{sec.why}</p>
                    <div class="t-nav">
                      <button type="button" class="a-btn t-prev" disabled={n === 0}>← {ui.templates.prev}</button>
                      <button type="button" class="a-btn t-next" disabled={n === tp.sections.length - 1}>{ui.templates.next} →</button>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="work" aria-labelledby="h-work">
      <p class="a-eyebrow">03</p>
      <h2 id="h-work">{ui.work.heading}</h2>
      <ul class="a-cards">
        {gridItems.map(({ type, w, i }) => type === 'card' ? (
          <li class={`a-card unf${w.featured ? ' a-featured' : ''}`} data-open="false" id={`w-${w.slug}`}>
            <span class="a-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="a-chips">
              <span class={`a-chip a-${w.status}`}>{ui.work.status[w.status]}</span>
            </div>
            <h3>{w.title[lang]}</h3>
            <p>{w.summary[lang]}</p>
            <p class="a-stack">{w.stack.join(' · ')}</p>
            {hasPage(w) && (
              <button type="button" class="a-btn unf-btn" data-drawer={`wd-${w.slug}`} aria-expanded="false" aria-controls={`wd-${w.slug}`} data-open-label={ui.work.open} data-close-label={ui.work.close}>
                <span class="unf-label">{ui.work.open}</span><span class="unf-chev" aria-hidden="true"></span>
              </button>
            )}
          </li>
        ) : (
          <li class="a-drawer unf" data-open="false" id={`wd-${w.slug}`} data-for={`w-${w.slug}`}>
            <div class="unf-doc"><div><div class="unf-in"><WorkDetail w={w} lang={lang} /></div></div></div>
          </li>
        ))}
      </ul>

      <div class="a-more unf" id="a-more" data-open="false">
        <div class="a-more-bar">
          <span class="label">{ui.work.more}</span>
          <div class="d-seg" role="group" aria-label={ui.work.more}>
            {moreWork.map((m) => (
              <button type="button" class="a-more-pill" data-slug={m.slug} aria-pressed="false" aria-controls="a-more-doc">{m.title[lang]}</button>
            ))}
          </div>
        </div>
        <div class="unf-doc" id="a-more-doc"><div><div class="unf-in">
          {moreWork.map((m) => (
            <div class="a-more-panel" data-slug={m.slug} hidden>
              <h3 class="a-more-title">{m.title[lang]}</h3>
              <p class="lede">{m.summary[lang]}</p>
              <p class="a-stack">{m.stack.join(' · ')}</p>
              <WorkDetail w={m} lang={lang} />
            </div>
          ))}
        </div></div></div>
      </div>
    </section>

    <section id="journey" aria-labelledby="h-journey">
      <p class="a-eyebrow">04</p>
      <h2 id="h-journey">{ui.journey.heading}</h2>
      <ol class="a-rail" id="a-rail">
        <span class="a-rail-fill" id="a-fill" aria-hidden="true"></span>
        {[...career].reverse().map((c) => (
          <li class={`a-step a-k-${c.kind}`}>
            <span class="a-pin" aria-hidden="true"></span>
            <div class="a-when">{c.period[lang]}<span>{c.place}</span></div>
            <div class="a-what">
              <h3>{c.title[lang]} <span class="a-org">{c.org}</span></h3>
              {c.summary && <p>{c.summary[lang]}</p>}
              {(c.homeHighlights ?? c.highlights) && <ul class="a-hl">{(c.homeHighlights ?? c.highlights)![lang].map((h) => <li>{h}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="cv" aria-labelledby="h-cv">
      <p class="a-eyebrow">05</p>
      <h2 id="h-cv">CV</h2>
      <div class="cvx unf" data-open="false" id="cvx">
        <button type="button" class="cvx-cover unf-btn" aria-expanded="false" aria-controls="cvx-doc" data-open-label={ui.cv.open} data-close-label={ui.cv.close}>
          <span class="cvx-mono" aria-hidden="true">CV</span>
          <span class="cvx-text">
            <span class="cvx-kicker">{ui.cv.coverKicker}</span>
            <span class="cvx-name">Juan Suárez</span>
            <span class="cvx-role">{role[lang]}</span>
            <span class="cvx-note">{ui.cv.coverNote}</span>
          </span>
          <span class="cvx-open"><span class="unf-label">{ui.cv.open}</span><span class="unf-chev" aria-hidden="true"></span></span>
        </button>
        <div class="unf-doc" id="cvx-doc"><div><div class="unf-in">
          <div class="cv-actions-inline">
            <button type="button" class="a-btn" id="cvx-print">{ui.cv.savePdf}</button>
            <a class="a-btn" href={url(`/${lang}/cv/`)}>{ui.cv.fullPage}</a>
          </div>
          <CvDocument lang={lang} />
          <div class="cv-close-row"><button type="button" class="a-btn unf-close">{ui.cv.close} ↑</button></div>
        </div></div></div>
      </div>
    </section>

    <section id="contact" aria-labelledby="h-contact">
      <p class="a-eyebrow">06</p>
      <h2 id="h-contact">{ui.contact.heading}</h2>
      <div class="a-contact">
        <a class="a-big" href="mailto:juansuarezdev@gmail.com">juansuarezdev@gmail.com</a>
        <a class="a-pill" href="https://github.com/juansuarezdev">GitHub</a>
        <a class="a-pill" href="https://www.linkedin.com/in/juansuarez-sanchez/">LinkedIn</a>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ BASE }}>
    (function () {
      var nodes = document.querySelectorAll('.a-node');
      var detail = document.getElementById('a-detail');
      var texts = JSON.parse(detail.dataset.steps);
      nodes.forEach(function (n) {
        function pick() {
          nodes.forEach(function (x) {
            x.setAttribute('aria-pressed', 'false');
            x.toggleAttribute('data-done', +x.dataset.i < +n.dataset.i);
          });
          n.setAttribute('aria-pressed', 'true');
          detail.textContent = texts[+n.dataset.i];
        }
        n.addEventListener('click', pick);
        n.addEventListener('mouseenter', pick);
      });
      document.querySelectorAll('.unf-btn:not([data-drawer])').forEach(function (b) {
        b.addEventListener('click', function () {
          var box = b.closest('.unf');
          var open = box.dataset.open === 'true';
          box.dataset.open = open ? 'false' : 'true';
          b.setAttribute('aria-expanded', open ? 'false' : 'true');
          var l = b.querySelector('.unf-label');
          if (l) l.textContent = open ? b.dataset.openLabel : b.dataset.closeLabel;
          if (!open && box.classList.contains('a-card')) setTimeout(function () { box.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' }); }, 250);
        });
      });
      var instant = matchMedia('(prefers-reduced-motion: reduce)').matches;
      function setCard(card, open) {
        card.dataset.open = open ? 'true' : 'false';
        var b = card.querySelector('.unf-btn');
        b.setAttribute('aria-expanded', open ? 'true' : 'false');
        b.querySelector('.unf-label').textContent = open ? b.dataset.closeLabel : b.dataset.openLabel;
      }
      function closeAllCards() {
        document.querySelectorAll('.a-card[data-open="true"]').forEach(function (c) { setCard(c, false); });
        document.querySelectorAll('.a-drawer[data-open="true"]').forEach(function (d) { d.dataset.open = 'false'; });
      }
      document.querySelectorAll('.unf-btn[data-drawer]').forEach(function (b) {
        b.addEventListener('click', function () {
          var card = b.closest('.a-card');
          var drawer = document.getElementById(b.dataset.drawer);
          var wasOpen = card.dataset.open === 'true';
          closeAllCards();
          if (wasOpen) return;
          setCard(card, true);
          drawer.dataset.open = 'true';
          setTimeout(function () {
            var top = drawer.getBoundingClientRect().top + window.scrollY - 140;
            window.scrollTo({ top: top, behavior: instant ? 'auto' : 'smooth' });
          }, 200);
        });
      });
      document.querySelectorAll('.unf-close').forEach(function (b) {
        b.addEventListener('click', function () {
          var box = b.closest('.unf');
          var head = box.querySelector(':scope > .unf-btn');
          if (box.classList.contains('a-drawer')) {
            var card = document.getElementById(box.dataset.for);
            card.querySelector('.unf-btn').click();
            card.scrollIntoView({ behavior: instant ? 'auto' : 'smooth', block: 'center' });
          } else if (head) { head.click(); head.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' }); }
          else if (box.id === 'a-more') {
            box.dataset.open = 'false';
            box.querySelectorAll('.a-more-pill').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
            box.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });
      var more = document.getElementById('a-more');
      var pills = more.querySelectorAll('.a-more-pill');
      var panels = more.querySelectorAll('.a-more-panel');
      pills.forEach(function (p) {
        p.addEventListener('click', function () {
          var same = p.getAttribute('aria-pressed') === 'true' && more.dataset.open === 'true';
          pills.forEach(function (x) { x.setAttribute('aria-pressed', !same && x === p ? 'true' : 'false'); });
          panels.forEach(function (pn) { pn.hidden = pn.dataset.slug !== p.dataset.slug; });
          more.dataset.open = same ? 'false' : 'true';
        });
      });
      var pr = document.getElementById('cvx-print');
      if (pr) {
        pr.addEventListener('click', function () {
          var f = document.getElementById('cv-frame');
          function go() { f.contentWindow.focus(); f.contentWindow.print(); }
          if (f) { go(); return; }
          f = document.createElement('iframe');
          f.id = 'cv-frame';
          f.setAttribute('aria-hidden', 'true');
          f.tabIndex = -1;
          f.style.cssText = 'position:fixed;width:0;height:0;border:0;opacity:0;pointer-events:none';
          f.addEventListener('load', go);
          f.src = '' + BASE + '/' + document.documentElement.lang + '/cv/';
          document.body.appendChild(f);
        });
      }
      var doc = document.getElementById('a-doc');
      var tabs = doc.querySelectorAll('.a-tab');
      function selectTab(tab) {
        tabs.forEach(function (x) {
          var on = x === tab;
          x.setAttribute('aria-selected', on ? 'true' : 'false');
          x.tabIndex = on ? 0 : -1;
          document.getElementById('panel-' + x.dataset.key).hidden = !on;
        });
      }
      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () { selectTab(tab); });
        tab.addEventListener('keydown', function (e) {
          var k = e.key, n = tabs.length;
          if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
          var t = tabs[(i + (k === 'ArrowRight' ? 1 : n - 1)) % n];
          selectTab(t); t.focus(); e.preventDefault();
        });
      });
      doc.querySelectorAll('.t-panel').forEach(function (panel) {
        var blocks = panel.querySelectorAll('.t-block');
        var items = panel.querySelectorAll('.t-ins');
        function show(n) {
          blocks.forEach(function (b, i) { b.setAttribute('aria-current', i === n ? 'true' : 'false'); });
          items.forEach(function (it, i) { it.hidden = i !== n; });
        }
        blocks.forEach(function (b, i) {
          b.addEventListener('click', function () {
            show(i);
            if (matchMedia('(max-width: 899px)').matches) {
              panel.querySelector('.t-inspector').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
            }
          });
          b.addEventListener('mouseenter', function () { if (matchMedia('(hover: hover)').matches) show(i); });
        });
        items.forEach(function (it, i) {
          it.querySelector('.t-prev').addEventListener('click', function () { show(i - 1); });
          it.querySelector('.t-next').addEventListener('click', function () { show(i + 1); });
        });
      });
      var map = document.querySelector('.a-map');
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (e, o) {
          if (e[0].isIntersecting) { map.classList.add('in'); o.disconnect(); }
        }, { threshold: 0.4 }).observe(map);
      } else { map.classList.add('in'); }
      var rail = document.getElementById('a-rail');
      var fill = document.getElementById('a-fill');
      function onScroll() {
        var r = rail.getBoundingClientRect();
        var p = (window.innerHeight * 0.6 - r.top) / r.height;
        fill.style.height = Math.max(0, Math.min(1, p)) * 100 + '%';
      }
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
</Base>

<style is:global>
  .a-hero { padding: 72px 0 72px; }
  .a-kicker { font-family: var(--mono); font-size: 0.8125rem; color: var(--accent); margin: 0 0 16px; }
  .a-title { font-size: clamp(2.25rem, 1rem + 6vw, 5rem); line-height: 1.02; letter-spacing: -0.03em; max-width: 16ch; margin: 0 0 16px; }
  .a-sub { font-size: 1.25rem; color: var(--muted); max-width: 46ch; margin-bottom: 48px; }

  .a-pipe { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; padding-top: 28px; }
  .a-pipe::before { content: ''; position: absolute; left: 10%; right: 10%; top: 38px; height: 2px; background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 20%, transparent)); }
  .a-packet { position: absolute; z-index: 0; top: 34px; left: 10%; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 16px 4px color-mix(in srgb, var(--accent) 60%, transparent); animation: a-flow 5s linear infinite; }
  .a-packet:nth-of-type(2) { animation-delay: -1.7s; }
  .a-packet:nth-of-type(3) { animation-delay: -3.4s; }
  @keyframes a-flow-v { from { top: 22px; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } to { top: calc(100% - 28px); opacity: 0; } }
  @keyframes a-flow { from { left: 10%; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } to { left: 90%; opacity: 0; } }
